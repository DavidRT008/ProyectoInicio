<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BrightSnow"
    android:orientation="vertical"
    tools:context=".VerificationActivity">

    <TextView
        android:id="@+id/txtVerificacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/basic_sans_serif_7"
        android:textAlignment="center"
        android:textColor="@color/CarbonBlack"
        android:textStyle="italic"
        android:textSize="30sp"
        android:text="@string/verificacion" />

    <ImageView
        android:id="@+id/imgVerif"
        android:layout_width="350dp"
        android:layout_height="310dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/img_corners"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:layout_marginTop="10dp"
        app:srcCompat="@drawable/verification" />

    <LinearLayout
        android:id="@+id/code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <EditText
            android:id="@+id/editTextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/plain_text_login"
            android:drawableStart="@drawable/number"
            android:drawablePadding="10dp"
            android:ems="10"
            android:hint="@string/introducir"
            android:inputType="text"
            android:padding="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColorHint="@color/CarbonBlack" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_login"
            android:text="@string/ingresar"
            android:textStyle="bold"
            android:textColor="@color/BrightSnow" />

        <TextView
            android:id="@+id/txtReenviar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/reenviar"
            android:textAlignment="textEnd"
            android:textColor="@color/black2" />

    </LinearLayout>

</LinearLayout>