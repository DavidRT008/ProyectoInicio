<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BrightSnow"
    android:orientation="vertical"
    tools:context=".RegisterActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/motorsyncperf" />

    <TextView
        android:id="@+id/txtBienvenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/basic_sans_serif_7"
        android:textAlignment="center"
        android:textColor="@color/CarbonBlack"
        android:textStyle="italic"
        android:textSize="30sp"
        android:text="@string/resgistrar" />

    <LinearLayout
        android:id="@+id/LogIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="80dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/txtInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/registrar2"
            android:textAlignment="textStart"
            android:textColor="@color/black2" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/btn_login"
            android:drawableStart="@drawable/google"
            android:drawablePadding="-35dp"
            android:text="@string/google"
            android:textColor="@color/BrightSnow" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFacebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/btn_login"
            android:drawableStart="@drawable/facebook"
            android:drawablePadding="-35dp"
            android:text="@string/facebook"
            android:textColor="@color/BrightSnow" />

        <EditText
            android:id="@+id/editCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/plain_text_login"
            android:drawableStart="@drawable/mail"
            android:drawablePadding="10dp"
            android:ems="10"
            android:hint="@string/correo"
            android:inputType="text"
            android:padding="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColorHint="@color/CarbonBlack" />

        <EditText
            android:id="@+id/editContraseña"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/plain_text_login"
            android:drawableStart="@drawable/password"
            android:drawablePadding="10dp"
            android:ems="10"
            android:hint="@string/contrasenia"
            android:inputType="text"
            android:padding="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="0dp"
            android:textColorHint="@color/CarbonBlack" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/SingUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_login"
            android:text="@string/registra3"
            android:textStyle="bold"
            android:textColor="@color/BrightSnow" />
    </LinearLayout>
</LinearLayout>